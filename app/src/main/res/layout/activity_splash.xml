<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2E2CD">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/splash_logo"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:contentDescription="Smart Pantry Manager logo"
            android:scaleType="fitCenter"
            android:src="@drawable/smart_pantry_manager_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="26dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:text="YOUR KITCHEN, SIMPLIFIED"
            android:textColor="#704025"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/splash_owner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/splash_owner"
            android:textColor="#704025"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
